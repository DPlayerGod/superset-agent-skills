# Local environment for `docker compose`. Listed in .gitignore — never commit this file.

# Required: the claude_gateway service refuses to start without it
# (docker-compose.yml uses ${CLAUDE_CODE_OAUTH_TOKEN:?...}).
# Generate with `claude setup-token` on a machine logged into the Claude
# Pro/Max account you want billed (`claude login` first if needed). Usage
# then draws on that account's subscription quota, not pay-per-token API
# billing, and does not go through the old ANTHROPIC_BASE_URL proxy.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: browser-facing Superset URL, used to build links/iframes handed to the
# browser. Defaults to http://localhost:8088 when unset — override only when
# deploying somewhere other than localhost.
# SUPERSET_PUBLIC_URL=http://localhost:8088

# Optional: alias ("sonnet", "opus", "fable") or full model name for claude_gateway.
# Leave unset to use the CLI's own default model.
CLAUDE_GATEWAY_MODEL=claude-haiku-4-5-20251001
